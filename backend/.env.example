# Banco Postgres no Supabase, schema isolado "overload" (não usa o schema
# "public", que tem tabelas de outros apps). Pegue a connection string em:
# Supabase Dashboard -> Connect -> Direct (aba "Connection string").
# Troque o usuário "postgres" pela role "overload_app" (criada com acesso
# restrito só ao schema overload) e a senha pela senha dela, e acrescente
# "?schema=overload" no final.
#
# Atenção: essa conexão direta usa IPv6. Se o serviço de deploy não tiver
# saída IPv6 (dá erro P1001 "Can't reach database server"), volte ao painel
# do Supabase, clique em "ORM" na tela de Connect e use a connection string
# do pooler (IPv4) que aparecer lá — normalmente com porta 6543 e
# "&pgbouncer=true" no final.
DATABASE_URL="postgresql://overload_app:SENHA@db.lhghfuvkjueorksmnxyt.supabase.co:5432/postgres?schema=overload"
DIRECT_URL="postgresql://overload_app:SENHA@db.lhghfuvkjueorksmnxyt.supabase.co:5432/postgres?schema=overload"

JWT_SECRET="troque-este-valor-por-um-segredo-forte"
PORT=3333
FRONTEND_URL="http://localhost:5173"
ANTHROPIC_API_KEY=""
