# Banco Postgres no Supabase, schema isolado "overload" (não usa o schema
# "public", que tem tabelas de outros apps). Pegue a connection string em:
# Supabase Dashboard -> Connect -> ORM -> Prisma (mostra a versão via pooler,
# compatível com IPv4 — a maioria das plataformas de deploy não tem saída
# IPv6, necessária para a conexão "Direct").
#
# Troque o usuário "postgres.<ref-do-projeto>" pela role "overload_app"
# mantendo o sufixo do projeto (o Supavisor/pooler exige esse sufixo pra
# rotear pro projeto certo): "overload_app.<ref-do-projeto>". Troque a senha
# pela senha da role, e acrescente "&schema=overload" no final de cada uma.
DATABASE_URL="postgresql://overload_app.SEU_PROJETO:SENHA@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=overload"
DIRECT_URL="postgresql://overload_app.SEU_PROJETO:SENHA@aws-0-us-west-2.pooler.supabase.com:5432/postgres?schema=overload"

JWT_SECRET="troque-este-valor-por-um-segredo-forte"
PORT=3333
FRONTEND_URL="http://localhost:5173"
ANTHROPIC_API_KEY=""
