# Banco Postgres no Supabase, schema isolado "overload" (não usa o schema
# "public", que tem tabelas de outros apps). Pegue as duas connection
# strings em: Supabase Dashboard -> Project Settings -> Database ->
# Connection string. Use a role "overload_app" (criada com acesso restrito
# só ao schema overload) em vez da role "postgres" padrão.
#
# DATABASE_URL: modo "Transaction" (porta 6543, para as queries da aplicação)
# DIRECT_URL:   modo "Session" (porta 5432, usado só para rodar migrações)
# Em ambos, adicione "?schema=overload" ao final; no DATABASE_URL, adicione
# também "&pgbouncer=true" (obrigatório para o pooler em modo transaction).
DATABASE_URL="postgresql://overload_app:SENHA@HOST-DO-POOLER:6543/postgres?schema=overload&pgbouncer=true"
DIRECT_URL="postgresql://overload_app:SENHA@HOST-DO-POOLER:5432/postgres?schema=overload"

JWT_SECRET="troque-este-valor-por-um-segredo-forte"
PORT=3333
FRONTEND_URL="http://localhost:5173"
ANTHROPIC_API_KEY=""
